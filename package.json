{
  "name": "opencode-plugin-voice",
  "version": "0.1.0",
  "type": "module",
  "description": "Dictation (STT) and read-aloud (TTS) for OpenCode — zero-config Edge voices, optional local Kitsune-TTS.",
  "license": "MIT",
  "author": "NakamuraIA",
  "homepage": "https://github.com/NakamuraIA/opencode-plugin-voice#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NakamuraIA/opencode-plugin-voice.git"
  },
  "bugs": {
    "url": "https://github.com/NakamuraIA/opencode-plugin-voice/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tts",
    "stt",
    "voice",
    "speech",
    "text-to-speech",
    "edge-tts",
    "kitsune"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "dist",
    "tools"
  ],
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/split-smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.6",
    "msedge-tts": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.8.2",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
